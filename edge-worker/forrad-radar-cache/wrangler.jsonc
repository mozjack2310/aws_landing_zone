{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forrad-radar-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "forradwx.app/radar/tiles/*",
      "zone_name": "forradwx.app"
    },
    {
      "pattern": "forradwx.app/api/v1/radar/*",
      "zone_name": "forradwx.app"
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
